<template>
  <view class="native-scenic">
    <view class="scenic-nav" :style="{paddingTop:statusH+'px'}">
      <button class="app-back-btn" :aria-label="t('返回')" @tap="goBack"><view class="app-back-icon"></view></button>
      <text class="nav-label">{{ t(panel==='catalog'?'全部景点':panel==='plan'?'规划路线':panel==='list'?'已选景点':'景点图鉴') }}</text>
      <button class="nav-more" :aria-label="t('更多操作')" @tap="menuOpen=!menuOpen">···</button>
    </view>

    <view v-if="menuOpen" class="menu-mask" @tap="menuOpen=false">
      <view class="scenic-menu" :style="{top:(statusH+58)+'px'}" @tap.stop>
        <button :disabled="!current || busy || !draftReady" @tap="toggleStop(current.id)">{{ t(added?'移出路线':'加入路线') }}</button>
        <button :disabled="!current" @tap="toggleAudio">{{ t('听景点') }}</button>
        <button @tap="openPanel('catalog')">{{ t('全部景点') }}</button>
        <button @tap="openPanel('list')">{{ t('已选景点') }}{{ draftReady?' · '+stops.length:'' }}</button>
        <button @tap="openPanel('plan')">{{ t('规划路线') }}</button>
      </view>
    </view>

    <view v-if="!panel" class="scenic-intro" @touchstart="onTouchStart" @touchend="onTouchEnd">
      <template v-if="current">
        <image v-if="cover(current)&&!failedImages[current.id]" :key="current.id" class="scenic-photo" :src="cover(current)" mode="aspectFill" @error="failedImages[current.id]=true" @tap="previewPhoto(current)" />
        <view v-else class="photo-missing"><text>{{ t('暂无景点图片') }}</text></view>
        <view class="photo-shade"></view>
        <view class="intro-content" :class="{expanded:introOpen}">
          <view v-if="!introOpen" class="thumb-strip">
            <button v-for="place in visibleSpots" :key="place.id" class="thumb" :class="{selected:place.id===current.id}" @tap.stop="choosePlace(place.id)">
              <image v-if="cover(place)" :src="cover(place)" mode="aspectFill" /><text>{{ t(place.name) }}</text>
            </button>
            <button class="thumb all-thumb" :aria-label="t('全部景点')" @tap.stop="openPanel('catalog')">···</button>
          </view>
          <view class="intro-heading"><text class="spot-title">{{ t(current.name) }}</text><button class="expand-button" :aria-label="t(introOpen?'收起介绍':'展开介绍')" @tap.stop="introOpen=!introOpen">{{ introOpen?'⌄':'⌃' }}</button></view>
          <scroll-view v-if="introOpen" scroll-y class="knowledge-scroll" :show-scrollbar="false" @touchstart.stop @touchend.stop>
            <view v-for="section in knowledgeSections" :key="section.key" class="knowledge-section"><text class="section-title">{{ t(section.title) }}</text><text class="section-text">{{ t(section.text) }}</text></view>
          </scroll-view>
          <text v-else class="spot-summary" @tap.stop="introOpen=true">{{ t(current.description || current.location || '') }}</text>
          <view class="intro-actions">
            <button :disabled="busy||!draftReady" @tap.stop="toggleStop(current.id)">{{ t(added?'已加入路线':'加入路线') }}</button>
            <button @tap.stop="toggleAudio">{{ t(audioOpen?'关闭讲解':'听讲解') }}</button>
            <button @tap.stop="openPanel('plan')">{{ t('查看路线') }}</button>
          </view>
        </view>
      </template>
      <view v-else-if="catalogError" class="load-state"><text>{{ t(catalogError) }}</text><button @tap="refresh">{{ t('重新加载') }}</button><button @tap="openPanel('catalog')">{{ t('全部景点') }}</button></view>
      <view v-else-if="loadingHintVisible" class="load-state"><text>{{ t(loading?'正在加载景点…':'暂无可用景点') }}</text></view>
    </view>

    <scroll-view v-else-if="panel==='catalog'" scroll-y class="catalog-scroll" :show-scrollbar="false">
      <view v-if="catalogError" class="inline-error"><text>{{ t(catalogError) }}</text><button @tap="refresh">{{ t('重试') }}</button></view>
      <view class="catalog-grid"><button v-for="place in catalog" :key="place.id" class="catalog-card" @tap="choosePlace(place.id)"><image v-if="cover(place)&&!failedImages[place.id]" :src="cover(place)" mode="aspectFill" @error="failedImages[place.id]=true" /><view v-else class="catalog-no-photo">{{ t('暂无图片') }}</view><text>{{ t(place.name) }}</text></button></view>
      <text v-if="!catalog.length&&loadingHintVisible&&!catalogError" class="list-note">{{ t(loading?'正在加载景点…':'暂无可用景点') }}</text>
    </scroll-view>

    <scroll-view v-else class="plan-scroll" :scroll-y="!dragging" :show-scrollbar="false">
      <view v-if="draftError" class="inline-error"><text>{{ t(draftError) }}</text><button @tap="refreshDraft">{{ t('重试') }}</button></view>
      <text v-if="!draftReady&&loadingHintVisible" class="list-note">{{ t('正在加载行程…') }}</text>
      <template v-if="draftReady">
        <view v-if="!stops.length" class="empty-route"><text>{{ t('还没有选择景点') }}</text><button @tap="openPanel('catalog')">{{ t('去选景点') }}</button></view>
        <template v-else>
          <view v-if="panel==='list'" class="saved-stops"><view v-for="(stop,index) in stops" :key="stop.id" class="saved-stop"><text>{{ index+1 }} · {{ t(stop.name) }}</text><button :disabled="busy" @tap="toggleStop(stop.id)">{{ t('移除') }}</button></view><button class="primary-action" @tap="openPanel('plan')">{{ t('规划路线') }}</button></view>
          <view v-else class="native-plan">
            <RouteTiming :key="planKey" :ids="selectedIds" :spots="routeSpots" :plan="routePlan" :pace="routePlan.pace" :disabled="busy" :details="showRouteDetails" @state="itineraryState=$event" @open="showRouteDetails=true" @close="showRouteDetails=false" @dragging="dragging=$event" @reorder="saveSettings({spot_ids:$event})" @remove="toggleStop" />
            <view class="plan-options">
              <text class="option-heading">{{ t('同行成员') }}</text>
              <view class="option-buttons"><button :class="{on:settings.elderly}" :disabled="busy" @tap="saveSettings({elderly:!settings.elderly})">{{ t('老人') }}</button><button :class="{on:settings.children}" :disabled="busy" @tap="saveSettings({children:!settings.children})">{{ t('小孩') }}</button><button :class="{on:settings.few_steps}" :disabled="busy" @tap="saveSettings({avoid_steps:!settings.few_steps})">{{ t('少走台阶') }}</button></view>
              <view class="gate-row"><text>{{ t('入园入口') }}</text><picker :disabled="busy" :range="gateLabels" :value="gateIndex(settings.start_area)" @change="saveSettings({start_area:gates[Number($event.detail.value)].value})"><view>{{ gateLabels[gateIndex(settings.start_area)] }} ›</view></picker></view>
              <view class="gate-row"><text>{{ t('离园出口') }}</text><picker :disabled="busy" :range="gateLabels" :value="gateIndex(settings.end_area)" @change="saveSettings({end_area:gates[Number($event.detail.value)].value})"><view>{{ gateLabels[gateIndex(settings.end_area)] }} ›</view></picker></view>
            </view>
            <button class="primary-action" :disabled="!canContinue||busy" @tap="chooseGuide">{{ t('选择数字人伴游') }}</button>
          </view>
        </template>
      </template>
    </scroll-view>

    <view v-if="audioOpen" class="native-audio">
      <button :disabled="audioLoading" @tap="togglePlayback">{{ audioLoading?'…':audioPlaying?'Ⅱ':'▶' }}</button>
      <view class="audio-info"><text>{{ current?t(current.name):'' }}</text><text>{{ formatTime(audioElapsed) }} / {{ audioDuration?formatTime(audioDuration):'—' }}</text></view>
      <button :aria-label="t('关闭讲解')" @tap="stopAudio">×</button>
    </view>
    <view v-if="!panel&&draftError" class="draft-notice" @tap="refreshDraft">{{ t('行程加载失败，点击重试') }}</view>
    <PageDock :active="0" :hidden="showRouteDetails" />
  </view>
</template>

<script>
import PageDock from '../../components/PageDock.vue'
import RouteTiming from '../../components/RouteTiming.vue'
import { SERVER_ORIGIN } from '../../common/config.js'
import { SCENIC_COVERS } from '../../common/scenic-covers.js'
import { scenicContext, scenicRequest, readScenicCatalog, loadScenicCatalog, loadScenicDraft, nativeCompanionUrl } from '../../common/scenic-api.js'
import { previewOptions } from '../../common/route-planning.js'

const GATES = [{value:'auto',label:'任意'},{value:'east',label:'东宫门'},{value:'north',label:'北宫门'},{value:'south',label:'新建宫门'}]
export default {
  components:{PageDock,RouteTiming},
  data() { return {
    catalog:readScenicCatalog(),currentId:null,panel:'',entryPanel:'',statusH:20,introOpen:false,menuOpen:false,
    loading:true,loadingHintVisible:false,catalogError:'',failedImages:{},stops:[],settings:{spot_ids:[]},draftReady:false,draftError:'',busy:false,
    showRouteDetails:false,dragging:false,itineraryState:{busy:false,error:'',data:null,key:''},gates:GATES,
    audioOpen:false,audioLoading:false,audioPlaying:false,audioElapsed:0,audioDuration:0,
  } },
  computed:{
    current(){return this.catalog.find(p=>String(p.id)===String(this.currentId)) || (this.currentId===null?this.catalog[0]:null) || null},
    visibleSpots(){const index=this.catalog.findIndex(p=>p.id===this.current?.id),start=Math.max(0,Math.min(index-3,this.catalog.length-4));return this.catalog.slice(start,start+4)},
    added(){return !!this.current&&this.stops.some(p=>p.id===this.current.id)},
    selectedIds(){return this.stops.map(p=>p.id)},
    routeSpots(){return this.catalog.map(p=>({...p,spot_id:p.id,spot_name:p.name}))},
    routePlan(){return {spot_ids:this.selectedIds,pace:this.settings.elderly||this.settings.children?'relaxed':'standard',start_area:this.settings.start_area||'auto',end_area:this.settings.end_area||'auto',avoid_steps:!!this.settings.avoid_steps}},
    planKey(){return JSON.stringify(previewOptions(this.selectedIds,this.routePlan,this.routePlan.pace))},
    canContinue(){const state=this.itineraryState;return this.draftReady&&this.stops.length>0&&!state.busy&&!state.error&&state.key===this.planKey&&!!state.data?.complete},
    gateLabels(){return this.gates.map(g=>this.t(g.label))},
    knowledgeSections(){const p=this.current||{};return [{key:'description',title:'景点介绍'},{key:'history_detail',title:'历史与文化'},{key:'tour_tips',title:'值得留意'},{key:'photo_tips',title:'拍照建议'},{key:'best_season',title:'季节建议'}].map(s=>({...s,text:p[s.key]})).filter(s=>s.text)},
  },
  onLoad(query){
    this._context=scenicContext();this._disposed=false
    const info=uni.getSystemInfoSync();this.statusH=info.statusBarHeight||20
    this.panel=['catalog','list','plan'].includes(query?.view)?query.view:'';this.entryPanel=this.panel
    if(query?.spotId)this.currentId=query.spotId
    this._handoff=query?.spotIds?query:null
    this._hintTimer=setTimeout(()=>{this.loadingHintVisible=true},180)
    this.refresh()
  },
  onShow(){
    const context=scenicContext()
    if(this._context&&context!==this._context){this._context=context;this.busy=false;this.stops=[];this.settings={spot_ids:[]};this.draftReady=false;this.itineraryState={};this.stopAudio();this._loadTask=null;this.refresh()}
    else if(this._loaded&&!this._loadTask)this.refreshDraft()
  },
  onHide(){this.menuOpen=false;this.stopAudio()},
  onUnload(){this._disposed=true;clearTimeout(this._hintTimer);this.stopAudio()},
  onBackPress(){if(this.showRouteDetails){this.showRouteDetails=false;return true}if(this.menuOpen){this.menuOpen=false;return true}if(this.panel&&this.panel!==this.entryPanel){this.panel='';return true}return false},
  methods:{
    alive(context){return !this._disposed&&context===scenicContext()},
    cover(place){return place?SCENIC_COVERS[place.name]||'':''},
    toast(message){uni.showToast({title:this.t(message),icon:'none'})},
    gateIndex(value){const index=this.gates.findIndex(g=>g.value===value);return index<0?0:index},
    openPanel(panel){this.stopAudio();this.menuOpen=false;this.panel=panel;this.introOpen=false},
    choosePlace(id){if(!this.catalog.some(p=>String(p.id)===String(id)))return;this.stopAudio();this.currentId=id;this.panel='';this.introOpen=false;this.menuOpen=false},
    previewPhoto(place){const src=this.cover(place);if(src)uni.previewImage({current:src,urls:[src]})},
    onTouchStart(e){const p=e.touches?.[0];if(p)this._touch={x:p.clientX,y:p.clientY}},
    onTouchEnd(e){const p=e.changedTouches?.[0],start=this._touch;this._touch=null;if(!p||!start||this.introOpen)return;const dx=p.clientX-start.x,dy=p.clientY-start.y;if(Math.abs(dx)<60||Math.abs(dx)<Math.abs(dy)*1.5)return;const index=this.catalog.findIndex(p=>p.id===this.current?.id),next=this.catalog[index+(dx<0?1:-1)];if(next)this.choosePlace(next.id)},
    goBack(){
      if(this.showRouteDetails){this.showRouteDetails=false;return}
      if(this.panel&&this.panel!==this.entryPanel){this.panel='';return}
      uni.navigateBack({delta:1,fail:()=>uni.reLaunch({url:'/pages/tabs/tabs?tab=home'})})
    },
    async refresh(){
      if(this._loadTask)return this._loadTask
      const context=scenicContext();this.catalogError='';this.loading=true
      const task=Promise.all([
        loadScenicCatalog().then(places=>{if(this.alive(context)){this.catalog=places;if(this.currentId!==null&&!places.some(p=>String(p.id)===String(this.currentId)))this.catalogError='该景点已不可用，请从全部景点重新选择'}}).catch(error=>{if(this.alive(context)&&!this.catalog.length)this.catalogError=error.message}),
        this.refreshDraft(),
      ]).then(()=>{if(this.alive(context))return this.applyHandoff()}).finally(()=>{if(this.alive(context)){this.loading=false;this._loaded=true;if(this._loadTask===task)this._loadTask=null}})
      this._loadTask=task;return task
    },
    applyDraft(draft){this.stops=draft.stops;this.settings=draft.settings;this.draftReady=true;this.draftError=''},
    async refreshDraft(){
      const context=scenicContext(),version=this._draftVersion=(this._draftVersion||0)+1
      try{const draft=await loadScenicDraft();if(this.alive(context)&&version===this._draftVersion)this.applyDraft(draft)}
      catch(error){if(this.alive(context)&&version===this._draftVersion)this.draftError=error.message}
    },
    async applyHandoff(){
      const query=this._handoff;if(!query||!this.draftReady||!this.catalog.length)return
      this._handoff=null
      const ids=String(query.spotIds).split(',').map(Number)
      if(!ids.length||ids.length>20||new Set(ids).size!==ids.length||ids.some(id=>!Number.isInteger(id)||!this.catalog.some(p=>p.id===id))){this.toast('部分景点已不可用，请重新选择');return}
      const context=scenicContext();this.busy=true
      try{
        for(const id of ids)if(!this.stops.some(p=>p.id===id))await scenicRequest('/scenic-selection?spot_id='+id,{method:'PUT'})
        for(const stop of this.stops)if(!ids.includes(stop.id))await scenicRequest('/scenic-selection/'+stop.id,{method:'DELETE'})
        const data={spot_ids:ids}
        for(const key of ['elderly','children'])if(query[key]!==undefined)data[key]=query[key]==='1'
        if(query.avoidSteps!==undefined)data.avoid_steps=query.avoidSteps==='1'
        for(const [source,key]of [['startArea','start_area'],['endArea','end_area']])if(GATES.some(g=>g.value===query[source]))data[key]=query[source]
        await scenicRequest('/scenic-settings',{method:'PUT',data})
        if(this.alive(context))await this.refreshDraft()
      }catch(error){if(this.alive(context)){this.toast(error.message);await this.refreshDraft()}}
      finally{if(this.alive(context))this.busy=false}
    },
    async toggleStop(id){
      if(this.busy||!this.draftReady)return
      const context=scenicContext(),removing=this.stops.some(p=>p.id===id);this.busy=true;this.menuOpen=false
      try{await scenicRequest(removing?'/scenic-selection/'+id:'/scenic-selection?spot_id='+id,{method:removing?'DELETE':'PUT'});if(this.alive(context))await this.refreshDraft()}
      catch(error){if(this.alive(context))this.toast(error.message)}
      finally{if(this.alive(context))this.busy=false}
    },
    async saveSettings(data){
      if(this.busy||!this.draftReady)return
      const context=scenicContext();this.busy=true
      try{const settings=await scenicRequest('/scenic-settings',{method:'PUT',data});if(!this.alive(context))return;this.settings=settings;if(data.spot_ids){const rows=new Map(this.stops.map(p=>[p.id,p]));this.stops=settings.spot_ids.map(id=>rows.get(id)).filter(Boolean)}}
      catch(error){if(this.alive(context))this.toast(error.message)}
      finally{if(this.alive(context))this.busy=false}
    },
    chooseGuide(){if(!this.canContinue||this.busy)return;uni.navigateTo({url:nativeCompanionUrl(this.selectedIds,this.routePlan),animationType:'slide-in-right',animationDuration:220})},
    stopAudio(){
      this._audioVersion=(this._audioVersion||0)+1
      const audio=this._audio;this._audio=null
      if(audio){try{audio.stop();audio.destroy()}catch(_){}}
      this.audioOpen=false;this.audioLoading=false;this.audioPlaying=false;this.audioElapsed=0;this.audioDuration=0
    },
    async toggleAudio(){
      this.menuOpen=false
      if(this.audioOpen){this.stopAudio();return}
      const place=this.current;if(!place)return
      const context=scenicContext(),version=this._audioVersion=(this._audioVersion||0)+1
      const current=()=>this.alive(context)&&version===this._audioVersion&&this.current?.id===place.id
      this.audioOpen=true;this.audioLoading=true
      try{
        const data=await scenicRequest('/scenic-audio/'+place.id)
        if(!current())return
        if(!data?.url)throw new Error('该景点讲解暂不可用')
        const audio=this._audio=uni.createInnerAudioContext()
        audio.onPlay(()=>{if(current()){this.audioPlaying=true;this.audioLoading=false}})
        audio.onPause(()=>{if(current())this.audioPlaying=false})
        audio.onEnded(()=>{if(current())this.audioPlaying=false})
        audio.onTimeUpdate(()=>{if(current()){this.audioElapsed=Number.isFinite(audio.currentTime)?audio.currentTime:0;if(audio.duration>0)this.audioDuration=audio.duration}})
        audio.onCanplay(()=>{if(current())this.audioLoading=false})
        audio.onError(()=>{if(current()){this.stopAudio();this.toast('音频加载失败，请重试')}})
        this.audioDuration=Number.isFinite(data.duration)?data.duration:0
        audio.src=/^https?:\/\//i.test(data.url)?data.url:SERVER_ORIGIN+data.url
        audio.play()
      }catch(error){if(current()){this.stopAudio();this.toast(error.message)}}
    },
    togglePlayback(){if(!this._audio||this.audioLoading)return;try{if(this.audioPlaying)this._audio.pause();else this._audio.play()}catch(_){this.stopAudio();this.toast('音频播放失败，请重试')}},
    formatTime(value){const seconds=Math.max(0,Math.floor(value||0));return Math.floor(seconds/60)+':'+String(seconds%60).padStart(2,'0')},
  },
}
</script>

<style scoped>
.native-scenic{height:100vh;height:100dvh;display:flex;flex-direction:column;overflow:hidden;background:#fff;color:#282332;padding-bottom:calc(72px + env(safe-area-inset-bottom));box-sizing:border-box}
.native-scenic button{margin:0;padding:0;background:none;border:0;font:inherit;color:inherit;line-height:1.5;border-radius:12px;min-height:44px;display:flex;align-items:center;justify-content:center}
.native-scenic button::after{border:0}.native-scenic button[disabled]{opacity:.45}.native-scenic button:active{transform:scale(.97)}
.scenic-nav{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:8px 18px 10px;flex-shrink:0;background:#fff;z-index:10}.nav-label{font-size:16px;font-weight:600}.nav-more{width:44px;letter-spacing:3px;border:1px solid #eee8ff!important;font-size:22px!important}
.scenic-intro{position:relative;flex:1;min-height:0;margin:0 8px;overflow:hidden;border-radius:26px 26px 0 0;background:#f7f4ff}.scenic-photo,.photo-missing,.photo-shade{position:absolute;inset:0;width:100%;height:100%}.photo-missing{display:flex;align-items:center;justify-content:center;color:#8b8495;background:#f4f1f9}.photo-shade{pointer-events:none;background:linear-gradient(180deg,transparent 30%,rgba(22,17,31,.12) 50%,rgba(22,17,31,.83) 100%)}
.intro-content{position:absolute;left:0;right:0;bottom:0;padding:22px 18px 18px;color:white;display:flex;flex-direction:column;max-height:86%;box-sizing:border-box}.intro-content.expanded{background:rgba(29,24,39,.84);border-radius:24px 24px 0 0;top:18%;max-height:none}.thumb-strip{display:flex;gap:6px;margin-bottom:14px;height:62px;flex-shrink:0}.thumb{position:relative;flex:1;min-width:0;height:62px;border:1px solid #ffffff55!important;border-radius:10px!important;overflow:hidden}.thumb.selected{border:2px solid #fff!important}.thumb image{position:absolute;inset:0;width:100%;height:100%}.thumb text{position:absolute;bottom:0;left:0;right:0;text-align:center;white-space:nowrap;font-size:10px;background:linear-gradient(transparent,#1c1729b3);padding:12px 2px 3px;overflow:hidden;text-overflow:ellipsis}.all-thumb{background:#ffffff20!important;font-size:24px!important}.intro-heading{display:flex;align-items:center;justify-content:space-between;flex-shrink:0}.spot-title{font-size:30px;font-weight:600;line-height:1.5}.expand-button{width:44px;font-size:26px!important}.spot-summary{font-size:14px;line-height:1.9;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin-top:5px}.intro-actions{display:flex;gap:10px;margin-top:16px;flex-shrink:0}.intro-actions button{flex:1;min-width:0;background:#ffffff26;border:1px solid #ffffff44;font-size:12px;padding:6px 3px}
.knowledge-scroll{flex:1;min-height:0;margin-top:12px}.knowledge-section+.knowledge-section{margin-top:24px}.section-title,.section-text{display:block}.section-title{font-size:18px;font-weight:600;margin-bottom:10px}.section-text{font-size:15px;line-height:1.95;white-space:pre-line}
.catalog-scroll,.plan-scroll{flex:1;height:0;min-height:0;box-sizing:border-box;background:#faf8ff}.catalog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;padding:16px}.catalog-card{display:flex!important;flex-direction:column;overflow:hidden;background:#fff!important;box-shadow:0 4px 18px #2c1a4e08;min-width:0;align-items:stretch!important}.catalog-card image,.catalog-no-photo{width:100%;height:156px}.catalog-no-photo{display:flex;align-items:center;justify-content:center;background:#eee8f5;color:#8b8495;font-size:13px}.catalog-card>text{padding:10px 12px;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.native-plan,.saved-stops{padding:14px 14px 24px}.plan-options{background:#fff;border-radius:18px;padding:16px;margin-top:16px}.option-heading{font-size:15px;font-weight:600}.option-buttons{display:flex;gap:10px;margin:12px 0 4px}.option-buttons button{flex:1;font-size:13px;background:#f3effa;border:1px solid #eee7f7}.option-buttons .on{color:#6651b2;background:#ece4ff;border-color:#a894e1}.gate-row{display:flex;justify-content:space-between;align-items:center;min-height:52px;border-top:1px solid #f3eff8;font-size:14px}.gate-row picker{padding:12px 0 12px 16px;color:#685490}.primary-action{width:100%;margin-top:20px!important;background:#7962bf!important;color:white!important;padding:12px!important;font-size:15px!important}.saved-stop{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:#fff;border-radius:14px;margin-bottom:10px;font-size:15px}.saved-stop button{color:#7861b3;font-size:13px;padding:4px 12px}.empty-route,.load-state{display:flex;flex-direction:column;gap:20px;align-items:center;justify-content:center;min-height:260px;padding:20px;font-size:15px}.load-state{position:absolute;inset:0}.empty-route button,.load-state button,.inline-error button{padding:8px 18px;background:#eee8ff;color:#6c56a7}.inline-error{padding:16px;display:flex;align-items:center;justify-content:space-between;gap:12px;color:#914e63;font-size:13px}.list-note{display:block;text-align:center;padding:50px 20px;color:#8b8495;font-size:14px}
.menu-mask{position:fixed;inset:0;z-index:90;background:#00000022}.scenic-menu{position:absolute;right:18px;min-width:164px;border:1px solid #eee7f7;border-radius:16px;background:#fff;padding:8px;box-shadow:0 10px 40px #27194020}.scenic-menu button{padding:7px 16px;justify-content:flex-start;font-size:14px}
.native-audio{position:fixed;bottom:calc(84px + env(safe-area-inset-bottom));left:20px;right:20px;z-index:60;display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:18px;border:1px solid #e8def3;background:#fff;box-shadow:0 8px 32px #2e20452b}.native-audio button{width:44px;flex-shrink:0;font-size:20px}.audio-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px;font-size:13px}.audio-info text:last-child{font-size:11px;color:#8b8495}.draft-notice{position:fixed;bottom:calc(80px + env(safe-area-inset-bottom));left:24px;right:24px;padding:10px;text-align:center;font-size:12px;color:#5e487c;background:#f5edff;z-index:30;border-radius:12px}
</style>
