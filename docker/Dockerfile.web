FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 TZ=Asia/Shanghai
WORKDIR /workspace/zhiyou-zhijing
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements/web.txt /tmp/requirements-web.txt
RUN pip install --no-cache-dir -r /tmp/requirements-web.txt
COPY server ./server
COPY shared ./shared
COPY data ./data
COPY configs ./configs
COPY static ./static
COPY scripts/import_resource_pack.py scripts/export_resource_pack.py scripts/publish_submitted_knowledge.py ./scripts/
COPY LICENSE ./LICENSE
EXPOSE 8000
CMD ["uvicorn", "server.base.base_server:app", "--host", "0.0.0.0", "--port", "8000"]
